# AzeuCafe server environment — copy to .env and adjust

PORT=5000

# Local MongoDB now; swap to a MongoDB Atlas URI later without any code change
MONGO_URI=mongodb://127.0.0.1:27017/azeucafe

# Where the client dev server runs (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Auth + encryption secrets (generate fresh hex with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace-with-64-hex-chars
AES_KEY=replace-with-64-hex-chars

# Seeded Owner account (public registration never creates owners)
OWNER_NAME=Owner
OWNER_EMAIL=owner@azeucafe.local
OWNER_PASSWORD=owner1234
