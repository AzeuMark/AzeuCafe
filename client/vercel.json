{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://azeucafe-production.up.railway.app//api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://azeucafe-production.up.railway.app//uploads/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
